7 4 4    # 8  pink
7 3 0    # 9  orange
4 2 0    # 10 brown
7 7 0    # 11 yellow
7 7 4    # 12 pale yellow
0 3 0    # 13 dark green
0 6 0    # 14 green
4 7 2    # 15 lime
0 3 3    # 16 teal
0 7 7    # 17 cyan
0 0 4    # 18 navy
0 2 7    # 19 blue
3 5 7    # 20 sky
3 0 4    # 21 purple
6 0 6    # 22 magenta
