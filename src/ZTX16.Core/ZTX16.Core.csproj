<Project Sdk="Microsoft.NET.Sdk">
  <!-- ZTX16 core library (collections). Shipped as source: the cartridge build compiles these files
       into every cartridge, so they are translated together with cartridge code. This project
       exists so the library is compiled and analyzed on its own as well. -->
  <ItemGroup>
    <ProjectReference Include="..\ZTX16.Sdk\ZTX16.Sdk.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <RootNamespace>ZTX16</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Cartridges compile these sources without implicit usings; so does this project. -->
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
</Project>
