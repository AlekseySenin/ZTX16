<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reference host: SDL3 window/input/audio, presentation through SDL's OpenGL renderer. -->
  <PropertyGroup>
    <!-- A GUI executable: no console window when double-clicked; it attaches to the terminal it was started from. -->
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ZTX16</AssemblyName>
    <RootNamespace>ZTX16.Host</RootNamespace>
    <ApplicationIcon>ztx16.ico</ApplicationIcon>
    <Product>ZTX16</Product>
    <Description>ZTX16 fantasy computer</Description>
  </PropertyGroup>
  <!-- Single-file publishing (tools/publish.ps1): one ZTX16.exe with the .NET runtime and SDL3 inside. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZTX16.Platform\ZTX16.Platform.csproj" />
    <ProjectReference Include="..\ZTX16.Cartridge\ZTX16.Cartridge.csproj" />
    <!-- The environment builds projects in-process (Console BUILD/RUN). -->
    <ProjectReference Include="..\ZTX16.Toolchain\ZTX16.Toolchain.csproj" />
    <!-- System apps: built as cartridges before the host, then copied into system/. -->
    <ProjectReference Include="..\..\apps\Console\Console.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopySystemApps" AfterTargets="Build">
    <ItemGroup>
      <ZTX16SystemApp Include="$(MSBuildThisFileDirectory)..\..\apps\*\bin\$(Configuration)\net10.0\*.ztx" />
    </ItemGroup>
    <Copy SourceFiles="@(ZTX16SystemApp)" DestinationFolder="$(OutDir)system" SkipUnchangedFiles="true" />
  </Target>
</Project>
