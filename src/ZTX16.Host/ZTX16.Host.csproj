<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reference host: SDL3 window/input/audio, presentation through SDL's OpenGL renderer. -->
  <PropertyGroup>
    <!-- A GUI executable: no console window when double-clicked; it attaches to the terminal it was started from. -->
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ZTX16</AssemblyName>
    <RootNamespace>ZTX16.Host</RootNamespace>
    <ApplicationIcon>ztx16.ico</ApplicationIcon>
    <Product>ZTX16</Product>
    <Description>ZTX16 fantasy computer</Description>
  </PropertyGroup>
  <!-- Single-file publishing (tools/publish.ps1): one ZTX16.exe with the .NET runtime and SDL3 inside. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZTX16.Platform\ZTX16.Platform.csproj" />
    <ProjectReference Include="..\ZTX16.Cartridge\ZTX16.Cartridge.csproj" />
    <!-- The environment builds projects in-process (Console BUILD/RUN). -->
    <ProjectReference Include="..\ZTX16.Toolchain\ZTX16.Toolchain.csproj" />
    <!-- System apps: built as cartridges before the host, then copied into system/. -->
    <ProjectReference Include="..\..\apps\Console\Console.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\apps\Code\Code.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\apps\Graphics\Graphics.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\apps\Help\Help.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- Everything the environment needs is also embedded, so ZTX16.exe works alone: the system apps, the core
       library sources and the reference assemblies for building cartridges (unpacked on demand). -->
  <Target Name="EmbedEnvironment" AfterTargets="ResolveAssemblyReferences" BeforeTargets="PrepareResources">
    <ItemGroup>
      <ZTX16EmbedApp Include="$(MSBuildThisFileDirectory)..\..\apps\*\bin\$(Configuration)\net10.0\*.ztx" />
      <ZTX16EmbedCore Include="$(MSBuildThisFileDirectory)..\ZTX16.Core\*.cs" />
      <ZTX16EmbedRef Include="$(NetCoreRoot)shared\Microsoft.NETCore.App\$(BundledNETCoreAppPackageVersion)\System.Private.CoreLib.dll" />
      <ZTX16EmbedRef Include="$(NetCoreRoot)shared\Microsoft.NETCore.App\$(BundledNETCoreAppPackageVersion)\System.Runtime.dll" />
      <ZTX16EmbedRef Include="@(ReferencePath->WithMetadataValue('Filename', 'ZTX16.Sdk'))" />
      <!-- The SDK's XML documentation: the Help app's API reference reads it. -->
      <ZTX16EmbedRef Include="@(ReferencePath->WithMetadataValue('Filename', 'ZTX16.Sdk')->'%(RootDir)%(Directory)%(Filename).xml')" />
      <EmbeddedResource Include="@(ZTX16EmbedApp)" LogicalName="system/%(ZTX16EmbedApp.Filename)%(ZTX16EmbedApp.Extension)" />
      <EmbeddedResource Include="@(ZTX16EmbedCore)" LogicalName="core/%(ZTX16EmbedCore.Filename)%(ZTX16EmbedCore.Extension)" />
      <EmbeddedResource Include="@(ZTX16EmbedRef)" LogicalName="ref/%(ZTX16EmbedRef.Filename)%(ZTX16EmbedRef.Extension)" />
    </ItemGroup>
    <Error Condition="!Exists('$(NetCoreRoot)shared\Microsoft.NETCore.App\$(BundledNETCoreAppPackageVersion)\System.Private.CoreLib.dll')"
           Text="The .NET runtime $(BundledNETCoreAppPackageVersion) was not found under $(NetCoreRoot)shared (needed to embed reference assemblies)." />
  </Target>
  <Target Name="CopySystemApps" AfterTargets="Build">
    <ItemGroup>
      <ZTX16SystemApp Include="$(MSBuildThisFileDirectory)..\..\apps\*\bin\$(Configuration)\net10.0\*.ztx" />
    </ItemGroup>
    <Copy SourceFiles="@(ZTX16SystemApp)" DestinationFolder="$(OutDir)system" SkipUnchangedFiles="true" />
  </Target>
</Project>
